{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Blue Bird: install",
      "type": "shell",
      "command": "npm install",
      "problemMatcher": []
    },
    {
      "label": "Blue Bird: dev server",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^x^" },
        "background": {
          "activesBegin": "VITE",
          "beginsPattern": "VITE",
          "endsPattern": "Local:"
        }
      }
    },
    {
      "label": "Blue Bird: production build",
      "type": "shell",
      "command": "npm run build",
      "group": "build",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Blue Bird: type-check",
      "type": "shell",
      "command": "npm run typecheck",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Blue Bird: export SVG assets",
      "type": "shell",
      "command": "npm run export:assets",
      "problemMatcher": []
    }
  ]
}
